APP_DOMAIN=staging.example.com
API_BASE_URL=https://staging.example.com

APP_NAME=GUPMAX AI
APP_VERSION=0.1.0-staging
ENVIRONMENT=staging
PILOT_MODE=true
GUPMAX_DEBUG=false
DOCS_ENABLED=false

DATABASE_URL=postgresql+asyncpg://gupmax_staging:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/gupmax_staging
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
POSTGRES_DB=gupmax_staging
POSTGRES_USER=gupmax_staging
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=https://staging.example.com
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_MODELS=
PAYMENTS_ENVIRONMENT=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
APP_PUBLIC_URL=https://staging.example.com
FRONTEND_URL=https://staging.example.com
PAYMENTS_TIMEOUT_SECONDS=15
